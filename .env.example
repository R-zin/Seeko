# Any OpenAI-compatible /chat/completions endpoint. Everything here can also be edited in the UI.
LLM_BASE_URL=http://localhost:11434/v1     # e.g. https://api.openai.com/v1, https://openrouter.ai/api/v1 ; blank = SDK default
LLM_API_KEY=                               # blank is fine for keyless local servers
LLM_MODEL=llama3.1
LLM_EXTRA_HEADERS={}                       # e.g. {"HTTP-Referer":"http://localhost","X-Title":"Seeko"}
# Optional per-task overrides (inherit base URL/key above)
SCORING_MODEL=
TAILOR_MODEL=
APPLIER_MODEL=
NOTION_TOKEN=
NOTION_DATABASE_ID=
APPROVAL_MODE=true
DAILY_APPLY_CAP=10
