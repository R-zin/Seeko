# Any OpenAI-compatible /chat/completions endpoint. Everything here can also be edited in the UI.
LLM_BASE_URL=http://localhost:11434/v1     # e.g. https://api.openai.com/v1, https://openrouter.ai/api/v1 ; blank = SDK default
LLM_API_KEY=                               # blank is fine for keyless local servers
LLM_MODEL=llama3.1
LLM_EXTRA_HEADERS={}                       # e.g. {"HTTP-Referer":"http://localhost","X-Title":"Seeko"}
# Optional per-task overrides (inherit base URL/key above)
SCORING_MODEL=
TAILOR_MODEL=
APPLIER_MODEL=
NOTION_TOKEN=
NOTION_DATABASE_ID=
APPROVAL_MODE=true
DAILY_APPLY_CAP=10

# Database. PostgreSQL keeps every job/internship found (with its full description), each search run and its
# LangGraph checkpoints. Blank = embedded PostgreSQL started by the app, data in data/postgres (no install needed).
# Or point at any server, e.g. `docker compose up -d db` -> postgresql://seeko:seeko@localhost:5432/seeko
DATABASE_URL=
# Job search politeness (also editable in Setup -> Sources)
SEARCH_MAX_DETAILS=25        # posting pages opened per source per run; the rest wait for the next run
SEARCH_MAX_PAGES=3           # result pages per search
SEARCH_DELAY_MIN_S=3
SEARCH_DELAY_MAX_S=8
SEARCH_RESPECT_ROBOTS=true   # careers pages
SEARCH_LLM_REVIEW=true       # model double-checks pages without structured job data
INDEED_HOST=www.indeed.com   # e.g. in.indeed.com
SEARCH_DAILY_PAGES=80        # page loads per browsed site per 24 h, across runs
SEARCH_BLOCK_COOLDOWN_H=12   # leave a site alone this long after a CAPTCHA / login wall / 429
